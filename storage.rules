rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isPlannerUser() {
      return request.auth != null
        && (
          request.auth.uid == 'mmyPWpFSPCdtHPhCDO3vLisaUuy1'
          || request.auth.token.email == 'amitdagan78@gmail.com'
        );
    }

    match /stories/{storyId}/summary.quill.json {
      allow read, write: if isPlannerUser();
    }

    match /stories/{storyId}/tasks/{taskId}/summary.quill.json {
      allow read, write: if isPlannerUser();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
