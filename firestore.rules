rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isAdminUser() {
      return isVerifiedUser()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.admin == true;
    }

    match /unitDefinitions/{unitId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    match /users/{userId} {
      allow read: if isVerifiedUser() && request.auth.uid == userId;
      allow create: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.admin == false;
      allow update: if isVerifiedUser()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.admin == resource.data.admin;
      allow delete: if false;
    }
  }
}
